# URL do projeto Supabase (ex.: https://seu-projeto.supabase.co)
VITE_SUPABASE_URL=

# Chave pública do Supabase (formato recomendado: sb_publishable_...)
# Para projetos legados, também é aceito VITE_SUPABASE_ANON_KEY como fallback.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Fallback opcional para chave pública legada (não preencher se já usar VITE_SUPABASE_PUBLISHABLE_KEY)
# VITE_SUPABASE_ANON_KEY=

# URL pública estável usada para links do cardápio, QR Code e gravação de tags NFC
VITE_PUBLIC_APP_URL=http://localhost:5173

